---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				margin-bottom: 4em;
				position: relative;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: -2em;
				left: -2em;
				width: 280px;
				height: 280px;
				background: var(--accent-gradient);
				opacity: 0.07;
				filter: blur(80px);
				border-radius: 50%;
				z-index: -1;
				pointer-events: none;
			}
			.hero h1 {
				font-size: 3.5em;
				margin: 0 0 0.3em 0;
				line-height: 1.05;
				letter-spacing: -0.035em;
			}
			.hero .tagline {
				font-size: 1.25em;
				color: var(--text-strong);
				margin-bottom: 1.5em;
				line-height: 1.45;
				font-weight: 500;
				max-width: 30ch;
			}
			.hero .intro {
				color: var(--text-muted);
				font-size: 1em;
				max-width: 56ch;
			}
			.post-cards {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.post-card {
				display: block;
				padding: 1.4em 1.6em;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 14px;
				text-decoration: none;
				color: var(--text);
				transition:
					border-color 200ms ease,
					transform 200ms ease,
					box-shadow 200ms ease;
			}
			.post-card:hover {
				border-color: var(--accent);
				transform: translateY(-2px);
				box-shadow: var(--shadow-md);
				text-decoration: none;
			}
			.post-card:hover .post-title {
				color: var(--accent);
			}
			.post-meta {
				font-size: 0.82em;
				color: var(--text-muted);
				margin: 0 0 0.4em 0;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-weight: 600;
			}
			.post-title {
				font-size: 1.3em;
				margin: 0 0 0.4em 0;
				color: var(--text-strong);
				transition: color 150ms ease;
				line-height: 1.3;
			}
			.post-desc {
				color: var(--text-muted);
				margin: 0;
				font-size: 0.95em;
				line-height: 1.55;
			}
			.see-all {
				margin-top: 2.5em;
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-weight: 600;
			}
			.see-all:hover {
				gap: 0.6em;
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 2.6em;
				}
				.hero .tagline {
					font-size: 1.1em;
				}
				.post-card {
					padding: 1.2em 1.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 class="gradient-text">{SITE_TITLE}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<p class="intro">
					A working notebook for thinking better about AI — alignment, governance,
					and the social impact of intelligent systems. Written for anyone who
					wants to reason carefully about where this technology is taking us.
				</p>
			</section>

			<section>
				<p class="section-label">Recent posts</p>
				<ul class="post-cards">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="post-card">
									<p class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-desc">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
				<a href="/blog" class="see-all">All posts <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>
