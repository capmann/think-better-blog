---
import { SITE_AUTHOR } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<span>&copy; {today.getFullYear()} {SITE_AUTHOR}</span>
		<div class="links">
			<a href="mailto:hello@thinkbetterabout.ai">Contact</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.9em;
	}
	.inner {
		max-width: 1080px;
		margin: 0 auto;
		padding: 1.5em;
		display: flex;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
	}
	.links {
		display: flex;
		gap: 1.25em;
	}
	a {
		color: var(--text-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text-strong);
	}
</style>
